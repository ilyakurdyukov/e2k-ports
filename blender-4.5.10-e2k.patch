diff --git a/intern/cycles/kernel/osl/osl.h b/intern/cycles/kernel/osl/osl.h
index bcb056ed..f79f18c1 100644
--- a/intern/cycles/kernel/osl/osl.h
+++ b/intern/cycles/kernel/osl/osl.h
@@ -85,7 +85,11 @@ ccl_device void flatten_closure_tree(KernelGlobals kg,
       case OSL_CLOSURE_MUL_ID: {
         const ccl_private OSLClosureMul *mul = static_cast<const ccl_private OSLClosureMul *>(
             closure);
+#ifdef __EDG__
+        weight = weight * mul->weight;
+#else
         weight *= mul->weight;
+#endif
         closure = mul->closure;
         continue;
       }
diff --git a/intern/cycles/util/math_float3.h b/intern/cycles/util/math_float3.h
index 5ceb88a3..9b8ff1e1 100644
--- a/intern/cycles/util/math_float3.h
+++ b/intern/cycles/util/math_float3.h
@@ -217,7 +217,7 @@ ccl_device_inline int3 operator>=(const float3 a, const float3 b)
 
 ccl_device_inline float dot(const float3 a, const float3 b)
 {
-#  if defined(__KERNEL_SSE42__) && defined(__KERNEL_SSE__)
+#  if defined(__KERNEL_SSE42__) && defined(__KERNEL_SSE__) && !defined(__e2k__)
   return _mm_cvtss_f32(_mm_dp_ps(a, b, 0x7F));
 #  else
   return a.x * b.x + a.y * b.y + a.z * b.z;
@@ -237,7 +237,7 @@ ccl_device_inline float dot_xy(const float3 a, const float3 b)
 
 ccl_device_inline float len(const float3 a)
 {
-#if defined(__KERNEL_SSE42__) && defined(__KERNEL_SSE__)
+#if defined(__KERNEL_SSE42__) && defined(__KERNEL_SSE__) && !defined(__e2k__)
   return _mm_cvtss_f32(_mm_sqrt_ss(_mm_dp_ps(a.m128, a.m128, 0x7F)));
 #else
   return sqrtf(dot(a, a));
@@ -281,7 +281,7 @@ ccl_device_inline float3 cross(const float3 a, const float3 b)
 
 ccl_device_inline float3 normalize(const float3 a)
 {
-#  if defined(__KERNEL_SSE42__) && defined(__KERNEL_SSE__)
+#  if defined(__KERNEL_SSE42__) && defined(__KERNEL_SSE__) && !defined(__e2k__)
   const __m128 norm = _mm_sqrt_ps(_mm_dp_ps(a.m128, a.m128, 0x7F));
   return float3(_mm_div_ps(a.m128, norm));
 #  else
diff --git a/intern/cycles/util/math_float4.h b/intern/cycles/util/math_float4.h
index ab36a162..4d25de6a 100644
--- a/intern/cycles/util/math_float4.h
+++ b/intern/cycles/util/math_float4.h
@@ -372,7 +372,7 @@ ccl_device_inline float reduce_max(const float4 a)
 #if !defined(__KERNEL_METAL__)
 ccl_device_inline float dot(const float4 a, const float4 b)
 {
-#  if defined(__KERNEL_SSE42__) && defined(__KERNEL_SSE__)
+#  if defined(__KERNEL_SSE42__) && defined(__KERNEL_SSE__) && !defined(__e2k__)
 #    if defined(__KERNEL_NEON__)
   const __m128 t = vmulq_f32(a, b);
   return vaddvq_f32(t);
diff --git a/intern/cycles/util/optimization.h b/intern/cycles/util/optimization.h
index 4eb231ea..ce23fc98 100644
--- a/intern/cycles/util/optimization.h
+++ b/intern/cycles/util/optimization.h
@@ -39,6 +39,15 @@
 #    define __KERNEL_SSE3__
 #    define __KERNEL_SSE42__
 
+#  elif defined(__e2k__)
+
+#    define __KERNEL_SSE__
+#    define __KERNEL_SSE2__
+#    define __KERNEL_SSE3__
+#    define __KERNEL_SSSE3__
+#    define __KERNEL_SSE41__
+#    define __KERNEL_SSE42__
+
 #  endif
 
 #endif
diff --git a/intern/cycles/util/simd.h b/intern/cycles/util/simd.h
